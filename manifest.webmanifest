{
  "name": "Swipe Sound",
  "short_name": "Swipe Sound",
  "description": "Swipe songs, learn your taste, discover music.",
  "id": "./",
  "start_url": "./#/swipe",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e0d14",
